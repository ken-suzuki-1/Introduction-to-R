c <- c(1,2,5,6,9,11,12)
d <- numeric(length(c))
for (i in seq_along(c)) {
if (c[i] < 8) {
2*c[i] + 3
} else if (c[i] >= 8 & c[i] < 12) {
0.5*c[i]
} else {
3*c[i]
}
}
d
c <- c(1,2,5,6,9,11,12)
d <- numeric(length(c))
for (i in seq_along(c)) {
if (c[i] < 8) {
d[i] <- 2*c[i] + 3
} else if (c[i] >= 8 & c[i] < 12) {
d[i] <- 0.5*c[i]
} else {
d[i] <- 3*c[i]
}
}
d
library(tidyverse)
#| output: false
library(tidyverse)
f1 <- function(x) {
# The next line begins our algorithm.
z <- if (x < 4) {
x^3
} else {
x^2
}
return(z)
}
f1(x = 3)
1:6 |> f1()
1:6 |> map(f1())
map(1:6, f1())
map(1:6, {f1()})
map(1:6, {f1(.x)})
1:6 |> map({f1(.x)})
1:6 |> map({f1()})
1:6 |> map({
f1()
})
map(1:6, .f = f1)
map(1:6, .f = f1) |> bind_rows()
1:6 |> map(.f = f1)
map(1:6, .f = f1)
e <- map(1:6, .f = f1)
e
#| echo: false
c <- c(1,2,5,6,9,11,12)
h1 <- function(x) {
if (x < 8) {
2*x + 3
} else if (x >= 8 & x < 12) {
0.5*x
} else {
3*x
}
}
h1(5)
c |> map(h1)
e <- map(1:6, .f = f1)
e
